{
  "name": "buildnex-platform",
  "version": "1.0.0",
  "description": "BuildNex – Smart Construction Management Platform",
  "private": true,
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "install:all": "npm install --prefix backend && npm install --prefix frontend",
    "build": "npm run build --prefix backend && npm run build --prefix frontend",
    "vercel-build": "npm run build",
    "start:backend": "npm start --prefix backend",
    "start:frontend": "npm run dev --prefix frontend"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "mongoose": "^8.3.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.12.7",
    "typescript": "^5.4.5"
  },
  "keywords": [
    "construction-management",
    "saas",
    "react",
    "typescript",
    "express",
    "mongodb",
    "tailwind"
  ],
  "author": "BuildNex Team"
}
