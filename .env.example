# BuildNex - Vercel & Production Environment Variables
# Note: In Vercel, set these in: Project Settings -> Environment Variables

# MongoDB Atlas Database URI (Optional - if omitted, runs in built-in demo mode)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/buildnex?retryWrites=true&w=majority

# OpenAI API Key for BuildNex AI Copilot (Optional)
OPENAI_API_KEY=

# Node Environment
NODE_ENV=production
